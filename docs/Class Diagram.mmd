%%{init: {"layout": "elk", "themeVariables": {"fontSize": "11px"}}}%%
classDiagram
    direction TB

    class User {
        <<SQLModel table>>
        +int id
        +str username
        +EmailStr email
        +str password
        +str role
        <<HOD, Deputy, TA>>
    }

    class Ta {
        <<SQLModel table>>
        +int id
        +str name
        +str email
        +Decimal hourly_rate
        +float performance_rating
    }

    class Course {
        <<SQLModel table>>
        +int id
        +str code
        +str title
        +int budgeted_hours
    }

    class Department {
        <<SQLModel table>>
        +int id = 1
        +int budget_hours_remaining
        +int round_robin_cursor
    }

    class Assignment {
        <<SQLModel table>>
        +int id
        +int ta_id
        +int course_id
        +int weekly_hours
        +int start_week
        +int end_week
        +str created_at
    }

    class TaExperience {
        <<SQLModel table>>
        +int id
        +int ta_id
        +int course_id
    }

    class AllocationService {
        <<service module>>
        +assign_manual(...) dict
        +assign_auto(...) dict
        +suggest_auto(...) dict
        +edit_assignment(...) dict
        +end_assignment(...) dict
    }

    class CapacityGuard {
        <<service>>
        +validate_request(...) void
        +validate_ta(...) void
        +eligible_candidates(...) list~dict~
    }

    class RankingStrategy {
        <<abstract service>>
        +rank(candidates, course_id, experience_pairs, load_by_ta) list~dict~
    }

    class ExperienceFirstStrategy {
        <<strategy>>
        +rank(...) list~dict~
    }

    class LeastLoadedStrategy {
        <<strategy>>
        +rank(...) list~dict~
    }

    class RoundRobinStrategy {
        <<strategy>>
        +rank(...) list~dict~
    }

    Ta "1" --> "0..*" Assignment
    Course "1" --> "0..*" Assignment
    Department "1" ..> "0..*" Assignment

    Ta "1" --> "0..*" TaExperience
    Course "1" --> "0..*" TaExperience

    User "0..*" ..> Ta
    User "0..*" ..> Department

    AllocationService ..> CapacityGuard
    AllocationService ..> RankingStrategy
    AllocationService --> "0..*" Assignment
    AllocationService --> "1" Department
    AllocationService --> "0..*" Ta
    AllocationService --> "0..*" Course

    RankingStrategy <|-- ExperienceFirstStrategy
    RankingStrategy <|-- LeastLoadedStrategy
    RankingStrategy <|-- RoundRobinStrategy

    note for User "role values represent HOD, Deputy, and TA access"
